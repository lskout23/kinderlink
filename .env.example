# Copy to .env.local and fill in your own values. Never commit .env.local.
APP_ENV=production
APP_DEBUG=false
APP_NAME=KinderLink
APP_NAME_GR=KinderLink
APP_URL=https://your-domain.example
APP_BASE_URL=
SESSION_NAME=kinderlink_session

DB_HOST=localhost
DB_NAME=kinderlink
DB_USER=your_database_user
DB_PASS=
DB_CHARSET=utf8mb4

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=KinderLink

# smtp or brevo; configure secrets in the environment or .env.local only.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email
